# Test environment template
APP_ENV=test
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
CSRF_TRUSTED_ORIGINS=
DJANGO_SECRET_KEY=django-insecure-test-key
DJANGO_SUPERUSER_BOOTSTRAP=False
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
USE_SQLITE=True
SQLITE_NAME=test.sqlite3
SQLITE_TIMEOUT_SECONDS=5

# Database
POSTGRES_DB=rdash_webhooks_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=False
DB_CONNECT_TIMEOUT=10

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True
CELERY_BROKER_POOL_LIMIT=1
CELERY_BROKER_HEARTBEAT=30
CELERY_VISIBILITY_TIMEOUT=3600
CELERY_TASK_TRACK_STARTED=False
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=100
CELERY_WORKER_MAX_MEMORY_PER_CHILD=0
CELERY_WORKER_SEND_TASK_EVENTS=False
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_DEFAULT_QUEUE=webhooks.default
CELERY_TASK_DEFAULT_RETRY_DELAY=60
CELERY_TASK_MAX_RETRIES=3
CELERY_BEAT_MAX_LOOP_INTERVAL=30

# Webhook delivery
WEBHOOK_CONNECT_TIMEOUT=5
WEBHOOK_READ_TIMEOUT=15
WEBHOOK_MAX_RETRIES=5
WEBHOOK_BASE_RETRY_DELAY=1.0
WEBHOOK_MAX_RETRY_DELAY=60.0
WEBHOOK_RETRY_JITTER=0.0
WEBHOOK_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
WEBHOOK_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=60
WEBHOOK_FANOUT_BATCH_SIZE=100
WEBHOOK_OUTBOX_DISPATCH_BATCH_SIZE=100
WEBHOOK_OUTBOX_STALE_LOCK_SECONDS=300
WEBHOOK_OUTBOX_BASE_RETRY_DELAY=1.0
WEBHOOK_OUTBOX_MAX_RETRY_DELAY=60.0
WEBHOOK_OUTBOX_DISPATCH_INTERVAL_SECONDS=5.0
WEBHOOK_TENANT_QUEUE_BUCKETS=16
WEBHOOK_DELIVERY_RATE_LIMIT=120/m
WEBHOOK_SECRET_ENCRYPTION_KEY=test-secret-encryption-key

# Runtime / Debugging
DEBUGPY_ENABLE=False
DEBUGPY_PORT=5678
DEBUGPY_WAIT_FOR_CLIENT=False
CELERY_WORKER_DEBUGPY_ENABLE=False
CELERY_WORKER_DEBUGPY_PORT=5680
CELERY_WORKER_DEBUGPY_WAIT_FOR_CLIENT=False
CELERY_WORKER_DEBUG_POOL=solo
CELERY_BEAT_DEBUGPY_ENABLE=False
CELERY_BEAT_DEBUGPY_PORT=5681
CELERY_BEAT_DEBUGPY_WAIT_FOR_CLIENT=False
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=60

# Logging
DJANGO_LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO
WEBHOOK_LOG_LEVEL=DEBUG
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=2
