# Production environment template
APP_ENV=production
DEBUG=False
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
DJANGO_SECRET_KEY=replace-with-production-secret-key
DJANGO_SUPERUSER_BOOTSTRAP=False
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com
USE_SQLITE=False
SQLITE_NAME=db.sqlite3
SQLITE_TIMEOUT_SECONDS=5

# Database
POSTGRES_DB=rdash_webhooks
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-production-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
DB_CONN_MAX_AGE=300
DB_CONN_HEALTH_CHECKS=True
DB_CONNECT_TIMEOUT=10

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True
CELERY_BROKER_POOL_LIMIT=20
CELERY_BROKER_HEARTBEAT=30
CELERY_VISIBILITY_TIMEOUT=3600
CELERY_TASK_TRACK_STARTED=True
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_MAX_MEMORY_PER_CHILD=0
CELERY_WORKER_SEND_TASK_EVENTS=False
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_DEFAULT_QUEUE=webhooks.default
CELERY_TASK_DEFAULT_RETRY_DELAY=60
CELERY_TASK_MAX_RETRIES=3
CELERY_BEAT_MAX_LOOP_INTERVAL=30

# Webhook delivery
WEBHOOK_CONNECT_TIMEOUT=5
WEBHOOK_READ_TIMEOUT=15
WEBHOOK_MAX_RETRIES=5
WEBHOOK_BASE_RETRY_DELAY=1.0
WEBHOOK_MAX_RETRY_DELAY=60.0
WEBHOOK_RETRY_JITTER=0.1
WEBHOOK_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
WEBHOOK_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=60
WEBHOOK_FANOUT_BATCH_SIZE=200
WEBHOOK_OUTBOX_DISPATCH_BATCH_SIZE=200
WEBHOOK_OUTBOX_STALE_LOCK_SECONDS=300
WEBHOOK_OUTBOX_BASE_RETRY_DELAY=1.0
WEBHOOK_OUTBOX_MAX_RETRY_DELAY=60.0
WEBHOOK_OUTBOX_DISPATCH_INTERVAL_SECONDS=5.0
WEBHOOK_TENANT_QUEUE_BUCKETS=16
WEBHOOK_DELIVERY_RATE_LIMIT=240/m
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-production-secret-encryption-key

# Debugging / server runtime
DEBUGPY_ENABLE=False
DEBUGPY_PORT=5678
DEBUGPY_WAIT_FOR_CLIENT=False
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=60

# Logging
DJANGO_LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO
WEBHOOK_LOG_LEVEL=INFO
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=10
